{
  "name": "ts-node-proj-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rolldown -c",
    "lint": "oxlint && dprint check",
    "lint:fix": "oxlint --fix && dprint fmt",
    "lint:ci": "oxlint --max-warnings 0 && dprint check",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "dprint": "^0.57.4",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "rolldown": "^1.2.8",
    "tsx": "^4.23.13"
  },
  "dependencies": {
  }
}
